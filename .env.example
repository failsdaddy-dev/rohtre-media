# Copy to .env.local and fill in. Never commit .env.local. Never paste values into chat.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase -> Project Settings -> API Keys
# Public (safe in the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# SERVER ONLY. Never in a NEXT_PUBLIC_* name.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Cloudinary -> Settings -> API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
# SERVER ONLY.
CLOUDINARY_API_SECRET=xxxxxxxx

# Resend (lead alert emails) -> resend.com -> API Keys. SERVER ONLY.
RESEND_API_KEY=re_xxxxxxxx
LEAD_ALERT_FROM=onboarding@resend.dev
LEAD_ALERT_TO=you@example.com

# Cloudflare Turnstile (spam protection) -> dash.cloudflare.com -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA
# SERVER ONLY.
TURNSTILE_SECRET_KEY=0x4AAAAAAA
