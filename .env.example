# Copy to .env.local and fill in. Never commit .env.local. Never paste values into chat.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase -> Project Settings -> API Keys
# Public (safe in the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# SERVER ONLY. Never in a NEXT_PUBLIC_* name.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Cloudinary -> Settings -> API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
# SERVER ONLY.
CLOUDINARY_API_SECRET=xxxxxxxx

# Leads -> Google Sheet (optional). See docs/setup/google-sheets-leads.md. SERVER ONLY.
LEADS_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/xxxx/exec
LEADS_SHEET_SECRET=xxxxxxxx
# Optional salt for hashing visitor IPs (rate limiting). SERVER ONLY.
LEAD_HASH_SALT=

# Supabase CLI only (terminal, never the website)
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxx
SUPABASE_DB_PASSWORD=xxxxxxxx
