# Copy to .env.local and fill in. Never commit .env.local. Never paste values into chat.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta Pixel (public). Set ENABLED=false on every non-production environment.
NEXT_PUBLIC_META_PIXEL_ID=1125813079510077
NEXT_PUBLIC_META_PIXEL_ENABLED=false

# Google Tag Manager (public, GTM-XXXXXXX). Set ENABLED=false on every non-production environment.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GTM_ENABLED=false

# Supabase -> Project Settings -> API Keys
# Public (safe in the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# SERVER ONLY. Never in a NEXT_PUBLIC_* name.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Cloudinary -> Settings -> API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
# SERVER ONLY.
CLOUDINARY_API_SECRET=xxxxxxxx

# Leads -> Google Sheet (optional). See docs/setup/google-sheets-leads.md. SERVER ONLY.
LEADS_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/xxxx/exec
LEADS_SHEET_SECRET=xxxxxxxx
# Optional salt for hashing visitor IPs (rate limiting). SERVER ONLY.
LEAD_HASH_SALT=

# Careers applications -> HR email through Gmail SMTP (free). SERVER ONLY.
# SMTP_USER = the Gmail address that sends; SMTP_PASS = a Gmail App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# See docs/setup/careers-email.md.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: where applications go if no HR email is saved in the admin.
CAREERS_NOTIFY_FALLBACK=
# Contact page enquiries -> sales email (same SMTP account as careers). SERVER ONLY.
# Comma-separated; empty = CAREERS_NOTIFY_FALLBACK, then SMTP_USER.
CONTACT_NOTIFY_EMAIL=

# Careers Phase 2 (OFF): WhatsApp Business Cloud API message to HR. SERVER ONLY.
CAREERS_WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_HR_NUMBER=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# Supabase CLI only (terminal, never the website)
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxx
SUPABASE_DB_PASSWORD=xxxxxxxx

# Secret admin sign-in address (12-80 letters, digits, - or _ after the slash).
# When set, /login and signed-out /admin answer 404. Restart `npm run dev` after changing.
ADMIN_LOGIN_PATH=
